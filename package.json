{
  "name": "@amerilux/netsuite-repository",
  "version": "1.0.0",
  "private": false,
  "description": "Entity Framework style data access for NetSuite SuiteScript: decorated models, a build step that generates configs and types, typed queries through the N/query object model, change tracking, and record updates.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "default": "./dist/query/index.js"
    },
    "./record-updater": {
      "types": "./dist/record-updater.d.ts",
      "default": "./dist/record-updater.js"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "default": "./dist/context.js"
    },
    "./model": {
      "types": "./dist/model/index.d.ts",
      "default": "./dist/model/index.js"
    },
    "./tracking": {
      "types": "./dist/tracking/index.d.ts",
      "default": "./dist/tracking/index.js"
    },
    "./coercion": {
      "types": "./dist/coercion.d.ts",
      "default": "./dist/coercion.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./cli": {
      "types": "./dist-tooling/tooling/index.d.ts",
      "default": "./dist-tooling/tooling/index.js"
    },
    "./plugin": {
      "types": "./dist-tooling/tooling/plugin.d.ts",
      "default": "./dist-tooling/tooling/plugin.js"
    }
  },
  "typesVersions": {
    "*": {
      "query": ["dist/query/index.d.ts"],
      "record-updater": ["dist/record-updater.d.ts"],
      "context": ["dist/context.d.ts"],
      "model": ["dist/model/index.d.ts"],
      "tracking": ["dist/tracking/index.d.ts"],
      "coercion": ["dist/coercion.d.ts"],
      "testing": ["dist/testing/index.d.ts"],
      "cli": ["dist-tooling/tooling/index.d.ts"],
      "plugin": ["dist-tooling/tooling/plugin.d.ts"]
    }
  },
  "files": [
    "dist",
    "dist-tooling",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:runtime && npm run build:tooling",
    "build:runtime": "tsc -p tsconfig.build.json",
    "build:tooling": "tsc -p tsconfig.tooling.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.tooling.json --noEmit",
    "pack": "npm pack",
    "pack:dry-run": "npm pack --dry-run",
    "publish:npm": "npm publish",
    "packAndPublish": "npm run build && npm run test && npm publish",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@hitc/netsuite-types": "2025.1.11",
    "@nizos/probity": "^1.5.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.9.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "5.8.3"
  },
  "publishConfig": {
    "tag": "latest",
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "netsuite-repository": "dist-tooling/tooling/cli/bin.js"
  },
  "peerDependencies": {
    "typescript": ">=5.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
